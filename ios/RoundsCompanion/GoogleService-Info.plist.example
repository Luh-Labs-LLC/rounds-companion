<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Placeholder only. Download the real GoogleService-Info.plist from the Firebase
  console (Project settings > Your apps > iOS app) and save it next to this file
  as GoogleService-Info.plist. That file is gitignored; never commit it.
  CI writes it from the GOOGLE_SERVICE_INFO_PLIST_BASE64 secret, and copies this
  placeholder for the unsigned compile check. The app cannot reach Firebase with it.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_ME</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.luhlabs.roundscompanion</string>
	<key>PROJECT_ID</key>
	<string>replace-me</string>
	<key>STORAGE_BUCKET</key>
	<string>replace-me.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<false/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
